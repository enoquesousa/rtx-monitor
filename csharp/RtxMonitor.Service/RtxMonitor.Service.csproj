<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <NativeLibraryDir Condition="'$(NativeLibraryDir)' == ''">$(MSBuildThisFileDirectory)..\..\build\windows-x64\bin\$(Configuration)</NativeLibraryDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RtxMonitor.Managed\RtxMonitor.Managed.csproj" />
    <ProjectReference Include="..\RtxMonitor.Storage\RtxMonitor.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\RtxMonitor.Console\PrivateWorkerClient.cs" Link="Experimental\PrivateWorkerClient.cs" />
    <Compile Include="..\RtxMonitor.Console\PrivateWorkerServer.cs" Link="Experimental\PrivateWorkerServer.cs" />
    <Compile Include="..\RtxMonitor.Console\PrivateSampleJson.cs" Link="Experimental\PrivateSampleJson.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Update="wwwroot\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Remove="wwwroot\**\*" Condition="'$(RtxMonNativeBundle)' == 'true'" />
  </ItemGroup>

  <ItemGroup Condition="'$(RtxMonIncludeResearchReaders)' == 'true'">
    <Content Include="..\..\scripts\research-readers\**\*"
             Exclude="..\..\scripts\research-readers\**\__pycache__\**;..\..\scripts\research-readers\**\*.pyc;..\..\scripts\research-readers\**\_runtime\**">
      <Link>research-readers\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CopyNativeMonitorLibraryForBuild" AfterTargets="Build" Condition="Exists('$(NativeLibraryDir)\rtxmon_native.dll')">
    <Copy
      SourceFiles="$(NativeLibraryDir)\rtxmon_native.dll"
      DestinationFolder="$(OutDir)"
      SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyNativeMonitorLibraryForPublish" AfterTargets="Publish" Condition="Exists('$(NativeLibraryDir)\rtxmon_native.dll')">
    <Copy
      SourceFiles="$(NativeLibraryDir)\rtxmon_native.dll"
      DestinationFolder="$(PublishDir)"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
