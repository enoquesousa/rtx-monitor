{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rtx-monitor:schema:gpuz-correlation:1",
  "title": "RTX Monitor GPU-Z internal correlation report",
  "description": "Zero-lag correlation among numeric channels from one external GPU-Z log.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_kind",
    "artifact_sha256",
    "reference_channel",
    "reference_unit",
    "sample_count",
    "session_count",
    "selected_session_index",
    "method",
    "pairs",
    "warnings"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "source_kind": { "const": "gpuz_internal_correlation" },
    "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "reference_channel": { "type": "string", "minLength": 1 },
    "reference_unit": { "type": "string" },
    "sample_count": { "type": "integer", "minimum": 1 },
    "session_count": { "type": "integer", "minimum": 1 },
    "selected_session_index": {
      "oneOf": [
        { "type": "null" },
        { "type": "integer", "minimum": 0 }
      ]
    },
    "method": { "const": "pearson_zero_lag" },
    "pairs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "channel_index",
          "channel",
          "unit",
          "source_scope",
          "sample_count",
          "coefficient",
          "status"
        ],
        "properties": {
          "channel_index": { "type": "integer", "minimum": 0 },
          "channel": { "type": "string", "minLength": 1 },
          "unit": { "type": "string" },
          "source_scope": { "enum": ["gpu_board", "host_system", "unknown"] },
          "sample_count": { "type": "integer", "minimum": 0 },
          "coefficient": {
            "oneOf": [
              { "type": "null" },
              { "type": "number", "minimum": -1, "maximum": 1 }
            ]
          },
          "status": {
            "enum": [
              "computed",
              "insufficient_samples",
              "constant_reference",
              "constant_candidate"
            ]
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
