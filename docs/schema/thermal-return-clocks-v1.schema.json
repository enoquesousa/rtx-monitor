{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rtx-monitor:schema:thermal-return-clocks:1",
  "title": "Thermal post-call clock sidecar (laboratory only)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_kind", "capture_session_id", "clock_command", "timestamp_event", "timestamp_interpolation", "call_count", "samples", "warning", "observation_sha256", "debugger_transcript_sha256"],
  "properties": {
    "schema_version": { "const": 1 },
    "source_kind": { "const": "thermal_return_clock_sidecar" },
    "capture_session_id": { "type": "string", "format": "uuid" },
    "clock_command": { "const": ".time -h 0" },
    "timestamp_event": { "const": "debugger_stopped_at_post_call" },
    "timestamp_interpolation": { "const": false },
    "call_count": { "type": "integer", "minimum": 1, "maximum": 100000 },
    "observation_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "debugger_transcript_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "warning": { "type": "string", "minLength": 1 },
    "samples": {
      "type": "array", "minItems": 1, "maxItems": 100000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["sequence", "channel_index", "selected_raw_fixed_8", "captured_at_utc", "timestamp_precision_ns", "system_uptime_100ns", "system_uptime_precision_ns"],
        "properties": {
          "sequence": { "type": "integer", "minimum": 1, "maximum": 100000 },
          "channel_index": { "enum": [0, 1] },
          "selected_raw_fixed_8": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
          "captured_at_utc": { "type": "string", "format": "date-time", "pattern": "Z$" },
          "timestamp_precision_ns": { "enum": [100, 1000, 10000, 100000, 1000000, 10000000, 100000000, 1000000000] },
          "system_uptime_100ns": { "type": "integer", "minimum": 0 },
          "system_uptime_precision_ns": { "enum": [100, 1000, 10000, 100000, 1000000, 10000000, 100000000, 1000000000] }
        }
      }
    }
  }
}
