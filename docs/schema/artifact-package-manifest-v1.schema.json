{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rtx-monitor:schema:artifact-package-manifest:1",
  "title": "RTX Monitor executable single-artifact package manifest",
  "description": "Exact contract written to manifest.json by rtxmon-lab create in the v0.8 MVP. The package directory contains only this file and artifact/payload.bin.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_kind",
    "artifact",
    "device"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source_kind": {
      "const": "user_provided_local_file"
    },
    "artifact": {
      "$ref": "#/$defs/artifact"
    },
    "device": {
      "$ref": "#/$defs/device"
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "original_file_name",
        "size_bytes",
        "sha256"
      ],
      "properties": {
        "relative_path": { "const": "artifact/payload.bin" },
        "original_file_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^(?=.*\\S)[^:/\\\\\\u0000-\\u001f\\u007f-\\u009f]+$",
          "not": { "enum": [".", ".."] }
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 268435456
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "canonicalNullableGpu": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        }
      ]
    },
    "canonicalNullableVersion": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        }
      ]
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gpu",
        "driver_version",
        "vbios_version"
      ],
      "properties": {
        "gpu": {
          "$ref": "#/$defs/canonicalNullableGpu"
        },
        "driver_version": {
          "$ref": "#/$defs/canonicalNullableVersion"
        },
        "vbios_version": {
          "$ref": "#/$defs/canonicalNullableVersion"
        }
      }
    }
  }
}
