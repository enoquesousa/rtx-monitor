{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rtx-monitor:schema:nvapi-call-observation:1",
  "title": "RTX Monitor NVAPI function call observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_kind",
    "captured_utc",
    "duration_seconds",
    "gpuz_sha256",
    "resolution_report_sha256",
    "target_count",
    "observed_target_count",
    "call_count",
    "targets",
    "warning"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source_kind": {
      "const": "nvapi_function_call_observation"
    },
    "captured_utc": {
      "type": "string",
      "format": "date-time"
    },
    "duration_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "gpuz_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "resolution_report_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "target_count": {
      "type": "integer",
      "minimum": 1
    },
    "observed_target_count": {
      "type": "integer",
      "minimum": 0
    },
    "call_count": {
      "type": "integer",
      "minimum": 0
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "module_name",
          "module_sha256",
          "rva",
          "interface_ids",
          "call_count"
        ],
        "properties": {
          "module_name": {
            "enum": [
              "nvapi.dll",
              "nvapi_impl.dll"
            ]
          },
          "module_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "rva": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{8}$"
          },
          "interface_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{8}$"
            }
          },
          "call_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "warning": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
