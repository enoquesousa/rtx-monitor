{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rtx-monitor:schema:gpuz-reference-analysis:1",
  "title": "GPU-Z sensor-log reference analysis",
  "description": "Deterministic offline import of a GPU-Z sensor log. Values are external reference observations and do not prove a physical sensor or a direct hardware interface.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_kind",
    "artifact",
    "sample_count",
    "session_count",
    "first_timestamp_local",
    "last_timestamp_local",
    "median_interval_ms",
    "timestamps_have_timezone",
    "channels",
    "samples",
    "warnings"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "source_kind": { "const": "gpuz_sensor_log_reference" },
    "artifact": { "$ref": "#/$defs/artifact" },
    "sample_count": { "type": "integer", "minimum": 1, "maximum": 250000 },
    "session_count": { "type": "integer", "minimum": 1, "maximum": 250000 },
    "first_timestamp_local": { "$ref": "#/$defs/localTimestamp" },
    "last_timestamp_local": { "$ref": "#/$defs/localTimestamp" },
    "median_interval_ms": { "type": ["number", "null"] },
    "timestamps_have_timezone": { "const": false },
    "channels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/channel" }
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 250000,
      "items": { "$ref": "#/$defs/sample" }
    },
    "warnings": {
      "type": "array",
      "minItems": 2,
      "maxItems": 16,
      "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["original_file_name", "size_bytes", "sha256", "text_encoding"],
      "properties": {
        "original_file_name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "size_bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "text_encoding": { "enum": ["utf-8", "iso-8859-1-fallback"] }
      }
    },
    "localTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?$"
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "name",
        "unit",
        "source_scope",
        "category",
        "representation",
        "sample_count",
        "missing_count",
        "numeric_statistics",
        "latest_raw",
        "distinct_raw_values"
      ],
      "properties": {
        "index": { "type": "integer", "minimum": 0, "maximum": 255 },
        "name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "unit": { "type": "string", "maxLength": 64 },
        "source_scope": { "enum": ["gpu_board", "host_system", "unknown"] },
        "category": {
          "enum": [
            "temperature",
            "clock",
            "fan",
            "voltage",
            "power",
            "utilization",
            "memory",
            "performance_limiter",
            "other"
          ]
        },
        "representation": { "enum": ["numeric", "raw_code", "text"] },
        "sample_count": { "type": "integer", "minimum": 0, "maximum": 250000 },
        "missing_count": { "type": "integer", "minimum": 0, "maximum": 250000 },
        "numeric_statistics": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/numericStatistics" }
          ]
        },
        "latest_raw": { "type": "string", "maxLength": 4096 },
        "distinct_raw_values": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "type": "string", "maxLength": 4096 }
        }
      }
    },
    "numericStatistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_count",
        "minimum",
        "maximum",
        "mean",
        "standard_deviation",
        "latest"
      ],
      "properties": {
        "sample_count": { "type": "integer", "minimum": 1, "maximum": 250000 },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "mean": { "type": "number" },
        "standard_deviation": { "type": "number", "minimum": 0 },
        "latest": { "type": "number" }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_index", "timestamp_local", "values"],
      "properties": {
        "session_index": { "type": "integer", "minimum": 0, "maximum": 249999 },
        "timestamp_local": { "$ref": "#/$defs/localTimestamp" },
        "values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "type": "string", "maxLength": 4096 }
        }
      }
    }
  }
}
