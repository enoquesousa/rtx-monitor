{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rtx-monitor:schema:nvapi-cooler-status-analysis:1",
  "title": "RTX Monitor offline cooler status analysis",
  "description": "Raw unsigned buffer statistics for the single validated observation profile, grouped by caller, entry position and field offset. Sequence-only observations do not establish RPM, PWM, physical sensor identity or temporal correlation. Optional GPU-Z ranges provide unsealed historical window context only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "source_kind", "mapping_status", "evidence_stage",
    "temporal_alignment", "source", "session", "sample_count", "call_sites",
    "fields", "warnings", "gpuz_reference"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "source_kind": { "const": "nvapi_cooler_status_analysis" },
    "mapping_status": { "const": "raw_unknown" },
    "evidence_stage": { "const": "raw_unknown" },
    "temporal_alignment": { "const": "unavailable_sequence_only" },
    "source": { "$ref": "#/$defs/source" },
    "session": { "$ref": "#/$defs/session" },
    "sample_count": { "type": "integer", "minimum": 2, "maximum": 1024 },
    "call_sites": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": { "$ref": "#/$defs/callSite" }
    },
    "fields": {
      "type": "array", "minItems": 8, "maxItems": 256,
      "items": { "$ref": "#/$defs/field" }
    },
    "warnings": { "$ref": "#/$defs/warnings" },
    "gpuz_reference": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/gpuzReference" }]
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "word": { "type": "string", "pattern": "^0x[0-9a-f]{8}$" },
    "unsignedValue": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "sequence": { "type": "integer", "minimum": 1, "maximum": 1024 },
    "callerRva": { "enum": ["0x0021d654", "0x0021d824"] },
    "timestamp": { "type": "string", "format": "date-time" },
    "localTimestamp": {
      "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$"
    },
    "warnings": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": [
        "original_file_name", "size_bytes", "sha256", "observation_schema_version",
        "observation_source_kind", "profile_name", "process_id", "gpuz_sha256",
        "debugger_sha256", "debugger_file_version", "identity_probe_sha256",
        "candidate_inventory_sha256", "prior_observation_sha256", "nvapi_module_sha256",
        "interface_id", "function_rva", "caller_module_name", "structure_version",
        "gpu_profile", "loaded_nvapi_module"
      ],
      "properties": {
        "original_file_name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "size_bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "observation_schema_version": { "const": 2 },
        "observation_source_kind": { "const": "nvapi_cooler_status_v1_observation" },
        "profile_name": { "const": "gpuz-2.70.0-nvapi-610.88-cooler-status-v1" },
        "process_id": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "gpuz_sha256": { "const": "6cb0ef29682452de81a9576808881685161411a1fad00938ba04131159979c29" },
        "debugger_sha256": { "$ref": "#/$defs/sha256" },
        "debugger_file_version": { "type": "string", "minLength": 1 },
        "identity_probe_sha256": { "$ref": "#/$defs/sha256" },
        "candidate_inventory_sha256": { "const": "3aaada9b367dacca7cf74511bae8532bd79b7f8bd06b9bb609056f3d9da1f1d7" },
        "prior_observation_sha256": { "const": "f580f67da61df2287257fb023fe277d310fdf424f588bbd96d01ac01433f8de2" },
        "nvapi_module_sha256": { "const": "fbc9aed43bfa5bda19b7f83a809a081a0ce454b6d6003dcabc565ecb3e6afdaf" },
        "interface_id": { "const": "0x35aed5e8" },
        "function_rva": { "const": "0x001b9f10" },
        "caller_module_name": { "const": "GPU-Z.exe" },
        "structure_version": { "const": "0x000106a8" },
        "gpu_profile": { "$ref": "#/$defs/gpuProfile" },
        "loaded_nvapi_module": { "$ref": "#/$defs/loadedModule" }
      }
    },
    "gpuProfile": {
      "type": "object", "additionalProperties": false,
      "required": [
        "gpu_index", "gpu_name", "gpu_uuid", "driver_version", "nvml_version", "pci_bus_id",
        "pci_vendor_id", "pci_device_id", "pci_subsystem_vendor_id", "pci_subsystem_device_id", "vbios_version"
      ],
      "properties": {
        "gpu_index": { "type": "integer", "minimum": 0, "maximum": 31 },
        "gpu_name": { "const": "NVIDIA GeForce RTX 3060" },
        "gpu_uuid": { "const": "GPU-fca3647e-8390-15a8-f23b-d0f870c9accd" },
        "driver_version": { "const": "610.88" },
        "nvml_version": { "const": "13.610.88" },
        "pci_bus_id": { "const": "00000000:01:00.0" },
        "pci_vendor_id": { "const": "0x10de" },
        "pci_device_id": { "const": "0x2504" },
        "pci_subsystem_vendor_id": { "const": "0x10de" },
        "pci_subsystem_device_id": { "const": "0x1536" },
        "vbios_version": { "const": "94.06.25.00.fc" }
      }
    },
    "loadedModule": {
      "type": "object", "additionalProperties": false,
      "required": ["file_name", "file_sha256", "start_address", "end_address", "proof_source"],
      "properties": {
        "file_name": { "const": "nvapi_impl.dll" },
        "file_sha256": { "const": "fbc9aed43bfa5bda19b7f83a809a081a0ce454b6d6003dcabc565ecb3e6afdaf" },
        "start_address": { "$ref": "#/$defs/word" },
        "end_address": { "$ref": "#/$defs/word" },
        "proof_source": { "const": "cdb_modload_target_image" }
      }
    },
    "session": {
      "type": "object", "additionalProperties": false,
      "required": ["capture_started_utc", "captured_utc", "duration_seconds", "reference_log"],
      "properties": {
        "capture_started_utc": { "$ref": "#/$defs/timestamp" },
        "captured_utc": { "$ref": "#/$defs/timestamp" },
        "duration_seconds": { "type": "integer", "minimum": 10, "maximum": 60 },
        "reference_log": { "$ref": "#/$defs/referenceLog" }
      }
    },
    "referenceLog": {
      "type": "object", "additionalProperties": false,
      "required": [
        "size_bytes_before", "size_bytes_midpoint", "size_bytes_after", "last_write_utc_before",
        "last_write_utc_midpoint", "last_write_utc_after", "last_sample_local_before",
        "last_sample_local_midpoint", "last_sample_local_after", "grew_during_capture"
      ],
      "properties": {
        "size_bytes_before": { "type": "integer", "minimum": 1 },
        "size_bytes_midpoint": { "type": "integer", "minimum": 1 },
        "size_bytes_after": { "type": "integer", "minimum": 1 },
        "last_write_utc_before": { "$ref": "#/$defs/timestamp" },
        "last_write_utc_midpoint": { "$ref": "#/$defs/timestamp" },
        "last_write_utc_after": { "$ref": "#/$defs/timestamp" },
        "last_sample_local_before": { "$ref": "#/$defs/localTimestamp" },
        "last_sample_local_midpoint": { "$ref": "#/$defs/localTimestamp" },
        "last_sample_local_after": { "$ref": "#/$defs/localTimestamp" },
        "grew_during_capture": { "const": true }
      }
    },
    "callSite": {
      "type": "object", "additionalProperties": false,
      "required": [
        "caller_rva", "sample_count", "minimum_observed_entry_count", "maximum_observed_entry_count",
        "first_sequence", "last_sequence"
      ],
      "properties": {
        "caller_rva": { "$ref": "#/$defs/callerRva" },
        "sample_count": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "minimum_observed_entry_count": { "type": "integer", "minimum": 1, "maximum": 32 },
        "maximum_observed_entry_count": { "type": "integer", "minimum": 1, "maximum": 32 },
        "first_sequence": { "$ref": "#/$defs/sequence" },
        "last_sequence": { "$ref": "#/$defs/sequence" }
      }
    },
    "field": {
      "type": "object", "additionalProperties": false,
      "required": [
        "caller_rva", "entry_ordinal", "base_word_index", "raw_field_byte_offset_within_entry",
        "raw_field_absolute_byte_offset", "valid_sample_count", "first_sequence", "last_sequence",
        "minimum_raw_value", "maximum_raw_value", "first_raw_value", "last_raw_value",
        "distinct_value_count", "transition_count", "raw_identifier_words"
      ],
      "properties": {
        "caller_rva": { "$ref": "#/$defs/callerRva" },
        "entry_ordinal": { "type": "integer", "minimum": 0, "maximum": 31 },
        "base_word_index": { "type": "integer", "minimum": 10, "maximum": 413 },
        "raw_field_byte_offset_within_entry": { "enum": [4, 8, 12, 16] },
        "raw_field_absolute_byte_offset": { "type": "integer", "minimum": 44, "maximum": 1668, "multipleOf": 4 },
        "valid_sample_count": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "first_sequence": { "$ref": "#/$defs/sequence" },
        "last_sequence": { "$ref": "#/$defs/sequence" },
        "minimum_raw_value": { "$ref": "#/$defs/unsignedValue" },
        "maximum_raw_value": { "$ref": "#/$defs/unsignedValue" },
        "first_raw_value": { "$ref": "#/$defs/unsignedValue" },
        "last_raw_value": { "$ref": "#/$defs/unsignedValue" },
        "distinct_value_count": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "transition_count": { "type": "integer", "minimum": 0, "maximum": 1023 },
        "raw_identifier_words": {
          "type": "array", "minItems": 1, "maxItems": 1024, "uniqueItems": true,
          "items": { "$ref": "#/$defs/unsignedValue" }
        }
      }
    },
    "gpuzReference": {
      "type": "object", "additionalProperties": false,
      "required": [
        "source_kind", "integrity_status", "alignment_method", "original_file_name",
        "prefix_size_bytes", "prefix_sha256", "selected_session_index", "window_first_timestamp_local",
        "window_last_timestamp_local", "window_sample_count", "channels", "warnings"
      ],
      "properties": {
        "source_kind": { "const": "gpuz_cooler_window_context" },
        "integrity_status": { "const": "unsealed_historical_reference" },
        "alignment_method": { "const": "window_only_no_sample_pairing" },
        "original_file_name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "prefix_size_bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
        "prefix_sha256": { "$ref": "#/$defs/sha256" },
        "selected_session_index": { "type": "integer", "minimum": 0, "maximum": 249999 },
        "window_first_timestamp_local": { "$ref": "#/$defs/localTimestamp" },
        "window_last_timestamp_local": { "$ref": "#/$defs/localTimestamp" },
        "window_sample_count": { "type": "integer", "minimum": 1, "maximum": 250000 },
        "channels": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/gpuzChannel" } },
        "warnings": { "$ref": "#/$defs/warnings" }
      }
    },
    "gpuzChannel": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "unit", "status", "sample_count", "missing_count", "minimum", "maximum", "mean"],
      "properties": {
        "name": { "enum": ["Fan 1 Speed (RPM)", "Fan 1 Speed (%)", "Fan 2 Speed (RPM)", "Fan 2 Speed (%)"] },
        "unit": { "enum": ["RPM", "%"] },
        "status": { "enum": ["available", "no_valid_samples", "channel_unavailable"] },
        "sample_count": { "type": "integer", "minimum": 0, "maximum": 250000 },
        "missing_count": { "type": "integer", "minimum": 0, "maximum": 250000 },
        "minimum": { "type": ["number", "null"] },
        "maximum": { "type": ["number", "null"] },
        "mean": { "type": ["number", "null"] }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "available" } } },
          "then": { "properties": {
            "sample_count": { "minimum": 1 },
            "minimum": { "type": "number" }, "maximum": { "type": "number" }, "mean": { "type": "number" }
          } },
          "else": { "properties": {
            "sample_count": { "const": 0 },
            "minimum": { "type": "null" }, "maximum": { "type": "null" }, "mean": { "type": "null" }
          } }
        },
        {
          "if": { "properties": { "name": { "enum": ["Fan 1 Speed (RPM)", "Fan 2 Speed (RPM)"] } } },
          "then": { "properties": { "unit": { "const": "RPM" } } },
          "else": { "properties": { "unit": { "const": "%" } } }
        }
      ]
    }
  }
}
