{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/enoquesousa/rtx-monitor/main/docs/schema/public-telemetry-v1.schema.json",
  "title": "RTX Monitor public telemetry report",
  "description": "One report emitted by --telemetry --json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gpu",
    "profile_key",
    "captured_at_unix_ms",
    "coverage",
    "fields",
    "computed_metrics"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "gpu": { "$ref": "#/$defs/gpu" },
    "profile_key": { "type": "string", "minLength": 1 },
    "captured_at_unix_ms": { "type": "integer", "minimum": 0 },
    "coverage": {
      "$ref": "telemetry-event-v3.schema.json#/$defs/coverage"
    },
    "fields": {
      "type": "array",
      "minItems": 31,
      "maxItems": 48,
      "items": {
        "$ref": "telemetry-event-v3.schema.json#/$defs/publicField"
      }
    },
    "computed_metrics": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "telemetry-event-v3.schema.json#/$defs/computedMetric"
      }
    }
  },
  "$defs": {
    "gpu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "name", "uuid", "driver_version", "nvml_version"],
      "properties": {
        "index": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "name": { "type": "string", "minLength": 1 },
        "uuid": { "type": "string", "minLength": 1 },
        "driver_version": { "type": "string" },
        "nvml_version": { "type": "string" }
      }
    }
  }
}
