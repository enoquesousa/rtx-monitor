{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rtx-monitor:schema:experiment-marker:1",
  "title": "RTX Monitor standalone experiment marker",
  "description": "One appendable scenario marker with UTC and system-monotonic timestamps.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "phase",
    "utc_unix_ms",
    "monotonic_ns",
    "monotonic_frequency_hz",
    "note"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "scenario_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "phase": { "enum": ["begin", "end", "note"] },
    "utc_unix_ms": { "type": "integer", "minimum": 0 },
    "monotonic_ns": { "type": "integer", "minimum": 0 },
    "monotonic_frequency_hz": { "type": "integer", "minimum": 1 },
    "note": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1, "maxLength": 4096 }
      ]
    }
  }
}
