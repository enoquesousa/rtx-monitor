{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rtx-monitor:schema:raw-artifact:1",
  "title": "RTX Monitor raw local artifact descriptor",
  "description": "Descriptor embedded in the executable v0.8 single-artifact package manifest. The payload is stored separately and is never embedded in JSON.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "relative_path",
    "original_file_name",
    "size_bytes",
    "sha256"
  ],
  "properties": {
    "relative_path": {
      "const": "artifact/payload.bin"
    },
    "original_file_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^(?=.*\\S)[^:/\\\\\\u0000-\\u001f\\u007f-\\u009f]+$",
      "not": {
        "enum": [".", ".."]
      }
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 268435456
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
