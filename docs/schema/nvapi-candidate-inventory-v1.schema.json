{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rtx-monitor:schema:nvapi-candidate-inventory:1",
  "title": "RTX Monitor NVAPI candidate inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_kind",
    "classification_artifact_sha256",
    "call_artifact_sha256",
    "gpuz_sha256",
    "captured_utc",
    "candidate_count",
    "executed_candidate_count",
    "executed_public_catalog_count",
    "executed_not_in_public_catalog_count",
    "resolved_not_observed_count",
    "candidates",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source_kind": {
      "const": "nvapi_candidate_inventory"
    },
    "classification_artifact_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "call_artifact_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "gpuz_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "captured_utc": {
      "type": "string",
      "format": "date-time"
    },
    "candidate_count": {
      "type": "integer",
      "minimum": 1
    },
    "executed_candidate_count": {
      "type": "integer",
      "minimum": 0
    },
    "executed_public_catalog_count": {
      "type": "integer",
      "minimum": 0
    },
    "executed_not_in_public_catalog_count": {
      "type": "integer",
      "minimum": 0
    },
    "resolved_not_observed_count": {
      "type": "integer",
      "minimum": 0
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "interface_id",
          "catalog_status",
          "public_function",
          "module_name",
          "module_sha256",
          "rva",
          "query_count",
          "observed_call_count",
          "execution_status",
          "semantic_status"
        ],
        "properties": {
          "interface_id": {
            "$ref": "#/$defs/interfaceId"
          },
          "catalog_status": {
            "enum": [
              "public_catalog_match",
              "not_in_public_catalog"
            ]
          },
          "public_function": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^NvAPI_[A-Za-z0-9_]+$"
          },
          "module_name": {
            "enum": [
              "nvapi.dll",
              "nvapi_impl.dll"
            ]
          },
          "module_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "rva": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{8}$"
          },
          "query_count": {
            "type": "integer",
            "minimum": 1
          },
          "observed_call_count": {
            "type": "integer",
            "minimum": 0
          },
          "execution_status": {
            "enum": [
              "executed_entry",
              "resolved_entry_not_observed"
            ]
          },
          "semantic_status": {
            "enum": [
              "public_symbol_only",
              "unidentified_binary_candidate"
            ]
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "interfaceId": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{8}$"
    }
  }
}
