{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rtx-monitor:schema:gpuz-device-io-control-observation:1",
  "title": "RTX Monitor GPU-Z DeviceIoControl observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_kind",
    "captured_utc",
    "duration_seconds",
    "gpuz_sha256",
    "process_id",
    "observed_api",
    "observation_count",
    "unique_signature_count",
    "signatures",
    "warning"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source_kind": {
      "const": "gpuz_device_io_control_observation"
    },
    "captured_utc": {
      "type": "string",
      "format": "date-time"
    },
    "duration_seconds": {
      "type": "integer",
      "minimum": 10,
      "maximum": 60
    },
    "gpuz_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "process_id": {
      "type": "integer",
      "minimum": 1
    },
    "observed_api": {
      "enum": [
        "kernelbase!DeviceIoControl",
        "ntdll!NtDeviceIoControlFile"
      ]
    },
    "observation_count": {
      "type": "integer",
      "minimum": 0
    },
    "unique_signature_count": {
      "type": "integer",
      "minimum": 0
    },
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "control_code",
          "device_type",
          "access",
          "function",
          "method",
          "input_size",
          "output_size",
          "handles",
          "call_count"
        ],
        "properties": {
          "control_code": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{8}$"
          },
          "device_type": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{4}$"
          },
          "access": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "function": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{3}$"
          },
          "method": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "input_size": {
            "type": "integer",
            "minimum": 0
          },
          "output_size": {
            "type": "integer",
            "minimum": 0
          },
          "handles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{8}$"
            }
          },
          "call_count": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "warning": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
