{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rtx-monitor:schema:nvapi-interface-classification:1",
  "title": "RTX Monitor NVAPI interface classification v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_kind",
    "observation_artifact_sha256",
    "interface_table_artifact_sha256",
    "gpuz_sha256",
    "captured_utc",
    "observation_count",
    "observed_unique_interface_count",
    "public_catalog_match_count",
    "not_in_public_catalog_count",
    "interfaces",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source_kind": {
      "const": "nvapi_interface_classification"
    },
    "observation_artifact_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "interface_table_artifact_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "gpuz_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "captured_utc": {
      "type": "string",
      "format": "date-time"
    },
    "observation_count": {
      "type": "integer",
      "minimum": 0
    },
    "observed_unique_interface_count": {
      "type": "integer",
      "minimum": 0
    },
    "public_catalog_match_count": {
      "type": "integer",
      "minimum": 0
    },
    "not_in_public_catalog_count": {
      "type": "integer",
      "minimum": 0
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "interface_id",
          "call_count",
          "classification",
          "public_function"
        ],
        "properties": {
          "interface_id": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{8}$"
          },
          "call_count": {
            "type": "integer",
            "minimum": 1
          },
          "classification": {
            "enum": [
              "public_catalog_match",
              "not_in_public_catalog"
            ]
          },
          "public_function": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^NvAPI_[A-Za-z0-9_]+$"
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
