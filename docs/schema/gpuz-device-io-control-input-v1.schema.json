{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rtx-monitor:schema:gpuz-device-io-control-input-observation:1",
  "title": "RTX Monitor GPU-Z DeviceIoControl bounded input observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_kind",
    "captured_utc",
    "duration_seconds",
    "gpuz_sha256",
    "process_id",
    "observation_report_sha256",
    "debug_log_sha256",
    "input_record_count",
    "unique_input_count",
    "inputs",
    "warning"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source_kind": {
      "const": "gpuz_device_io_control_input_observation"
    },
    "captured_utc": {
      "type": "string",
      "format": "date-time"
    },
    "duration_seconds": {
      "type": "integer",
      "minimum": 10,
      "maximum": 60
    },
    "gpuz_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "process_id": {
      "type": "integer",
      "minimum": 1
    },
    "observed_api": {
      "enum": [
        "kernelbase!DeviceIoControl",
        "ntdll!NtDeviceIoControlFile"
      ]
    },
    "observation_report_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "debug_log_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "input_record_count": {
      "type": "integer",
      "minimum": 0
    },
    "unique_input_count": {
      "type": "integer",
      "minimum": 0
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "control_code",
          "input_size",
          "dwords",
          "call_count"
        ],
        "properties": {
          "control_code": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{8}$"
          },
          "input_size": {
            "enum": [
              4,
              12
            ]
          },
          "dwords": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{8}$"
            }
          },
          "call_count": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "warning": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
