{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rtx-monitor:schema:nvapi-therm-channel-v2-observation:1",
  "title": "RTX Monitor NVAPI thermal channel v2 observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_kind",
    "capture_started_utc",
    "captured_utc",
    "duration_seconds",
    "process_id",
    "gpuz_sha256",
    "debugger_sha256",
    "debugger_file_version",
    "candidate_inventory_sha256",
    "prior_observation_sha256",
    "nvapi_module_sha256",
    "interface_id",
    "function_rva",
    "caller_module_name",
    "caller_rva",
    "structure_version",
    "structure_size_bytes",
    "fixed_point_fractional_bits",
    "value_word_indices",
    "reference_log",
    "call_count",
    "samples",
    "warning"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source_kind": {
      "const": "nvapi_therm_channel_v2_observation"
    },
    "capture_started_utc": {
      "type": "string",
      "format": "date-time"
    },
    "captured_utc": {
      "type": "string",
      "format": "date-time"
    },
    "duration_seconds": {
      "type": "integer",
      "minimum": 10,
      "maximum": 60
    },
    "process_id": {
      "type": "integer",
      "minimum": 1
    },
    "gpuz_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "debugger_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "debugger_file_version": {
      "type": "string",
      "minLength": 1
    },
    "candidate_inventory_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "prior_observation_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "nvapi_module_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "interface_id": {
      "const": "0x65fe3aad"
    },
    "function_rva": {
      "const": "0x001ad310"
    },
    "caller_module_name": {
      "const": "GPU-Z.exe"
    },
    "caller_rva": {
      "const": "0x002225b5"
    },
    "structure_version": {
      "const": "0x000200a8"
    },
    "structure_size_bytes": {
      "const": 168
    },
    "fixed_point_fractional_bits": {
      "const": 8
    },
    "value_word_indices": {
      "type": "array",
      "prefixItems": [
        {
          "const": 10
        },
        {
          "const": 11
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "reference_log": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size_bytes_before",
        "size_bytes_midpoint",
        "size_bytes_after",
        "last_write_utc_before",
        "last_write_utc_midpoint",
        "last_write_utc_after",
        "last_sample_local_before",
        "last_sample_local_midpoint",
        "last_sample_local_after",
        "grew_during_capture"
      ],
      "properties": {
        "size_bytes_before": {
          "type": "integer",
          "minimum": 1
        },
        "size_bytes_midpoint": {
          "type": "integer",
          "minimum": 1
        },
        "size_bytes_after": {
          "type": "integer",
          "minimum": 1
        },
        "last_write_utc_before": {
          "type": "string",
          "format": "date-time"
        },
        "last_write_utc_midpoint": {
          "type": "string",
          "format": "date-time"
        },
        "last_write_utc_after": {
          "type": "string",
          "format": "date-time"
        },
        "last_sample_local_before": {
          "$ref": "#/$defs/local_timestamp"
        },
        "last_sample_local_midpoint": {
          "$ref": "#/$defs/local_timestamp"
        },
        "last_sample_local_after": {
          "$ref": "#/$defs/local_timestamp"
        },
        "grew_during_capture": {
          "const": true
        }
      }
    },
    "call_count": {
      "type": "integer",
      "minimum": 1
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "thread_id",
          "channel_index",
          "return_status",
          "structure_version",
          "channel_mask",
          "raw_words",
          "selected_word_index",
          "selected_raw_fixed_8",
          "selected_celsius"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "thread_id": {
            "$ref": "#/$defs/word"
          },
          "channel_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          },
          "return_status": {
            "$ref": "#/$defs/word"
          },
          "structure_version": {
            "const": "0x000200a8"
          },
          "channel_mask": {
            "enum": [
              "0x00000001",
              "0x00000002"
            ]
          },
          "raw_words": {
            "type": "array",
            "minItems": 42,
            "maxItems": 42,
            "items": {
              "$ref": "#/$defs/word"
            }
          },
          "selected_word_index": {
            "enum": [
              10,
              11
            ]
          },
          "selected_raw_fixed_8": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "selected_celsius": {
            "type": "number"
          }
        }
      }
    },
    "warning": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "word": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{8}$"
    },
    "local_timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$"
    }
  }
}
