{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rtx-monitor:schema:nvapi-voltage-status-correlation:2",
  "title": "RTX Monitor NVAPI voltage status correlation v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_kind",
    "capture_session_id",
    "profile_name",
    "observation_sha256",
    "gpuz_sha256",
    "nvapi_module_sha256",
    "interface_id",
    "function_rva",
    "caller_module_name",
    "caller_rva",
    "structure_version",
    "scale_divisor",
    "mapping_status",
    "mapping",
    "gpuz_reference",
    "hwinfo_reference",
    "warnings"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "source_kind": { "const": "nvapi_voltage_status_reference_correlation" },
    "capture_session_id": { "type": "string", "format": "uuid" },
    "profile_name": { "const": "gpuz-2.70.0-nvapi-610.88-voltage-status-v1" },
    "observation_sha256": { "$ref": "#/$defs/sha256" },
    "gpuz_sha256": { "const": "6cb0ef29682452de81a9576808881685161411a1fad00938ba04131159979c29" },
    "nvapi_module_sha256": { "const": "fbc9aed43bfa5bda19b7f83a809a081a0ce454b6d6003dcabc565ecb3e6afdaf" },
    "interface_id": { "const": "0x465f9bcf" },
    "function_rva": { "const": "0x00198010" },
    "caller_module_name": { "const": "GPU-Z.exe" },
    "caller_rva": { "const": "0x0021cee7" },
    "structure_version": { "const": "0x0001004c" },
    "scale_divisor": { "const": 1000000 },
    "mapping_status": {
      "enum": ["matched_external_reference", "ambiguous_or_outside_tolerance"]
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "word_index",
        "offset_bytes",
        "semantic_field",
        "unit",
        "observation_sample_count",
        "distinct_raw_value_count",
        "status"
      ],
      "properties": {
        "word_index": { "const": 10 },
        "offset_bytes": { "const": 40 },
        "semantic_field": { "const": "gpu_core_voltage" },
        "unit": { "const": "V" },
        "observation_sample_count": { "type": "integer", "minimum": 3 },
        "distinct_raw_value_count": { "type": "integer", "minimum": 1 },
        "status": {
          "enum": ["matched_external_reference", "ambiguous_or_outside_tolerance"]
        }
      }
    },
    "gpuz_reference": { "$ref": "#/$defs/reference_result" },
    "hwinfo_reference": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/reference_result" }
      ]
    },
    "warnings": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "reference_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "artifact_prefix_sha256",
        "artifact_prefix_size_bytes",
        "reference_channel",
        "reference_unit",
        "alignment_method",
        "sample_count",
        "selected_session_index",
        "window_first_timestamp_local",
        "window_last_timestamp_local",
        "maximum_alignment_delta_ms",
        "mean_absolute_error_volts",
        "maximum_absolute_error_volts",
        "tolerance_volts",
        "status"
      ],
      "properties": {
        "source": { "enum": ["GPU-Z", "HWiNFO"] },
        "artifact_prefix_sha256": { "$ref": "#/$defs/sha256" },
        "artifact_prefix_size_bytes": { "type": "integer", "minimum": 1 },
        "reference_channel": { "type": "string", "minLength": 1 },
        "reference_unit": { "const": "V" },
        "alignment_method": { "type": "string", "minLength": 1 },
        "sample_count": { "type": "integer", "minimum": 3 },
        "selected_session_index": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 0 }
          ]
        },
        "window_first_timestamp_local": { "type": "string", "minLength": 1 },
        "window_last_timestamp_local": { "type": "string", "minLength": 1 },
        "maximum_alignment_delta_ms": {
          "oneOf": [
            { "type": "null" },
            { "type": "number", "minimum": 0 }
          ]
        },
        "mean_absolute_error_volts": { "type": "number", "minimum": 0 },
        "maximum_absolute_error_volts": { "type": "number", "minimum": 0 },
        "tolerance_volts": { "type": "number", "exclusiveMinimum": 0 },
        "status": { "enum": ["matched_rounding_tolerance", "outside_tolerance"] }
      }
    }
  }
}
