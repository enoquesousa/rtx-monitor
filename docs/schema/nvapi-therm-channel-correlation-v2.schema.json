{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rtx-monitor:schema:nvapi-therm-channel-correlation:2",
  "title": "RTX Monitor NVAPI thermal channel correlation v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_kind",
    "capture_session_id",
    "profile_name",
    "gpu",
    "observation_sha256",
    "identity_probe_sha256",
    "gpuz_sha256",
    "debugger_sha256",
    "nvapi_module_sha256",
    "loaded_nvapi_module",
    "interface_id",
    "function_rva",
    "caller_module_name",
    "caller_rva",
    "structure_version",
    "fixed_point_fractional_bits",
    "alignment_method",
    "tolerance_celsius",
    "minimum_direct_advantage_celsius",
    "selection",
    "direct_comparison",
    "inverted_comparison",
    "mapping_status",
    "warnings"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "source_kind": { "const": "nvapi_therm_channel_reference_correlation" },
    "capture_session_id": { "type": "string", "format": "uuid" },
    "profile_name": {
      "const": "gpuz-2.70.0-nvapi-610.88-therm-channel-status-v2"
    },
    "gpu": { "$ref": "#/$defs/gpu" },
    "observation_sha256": { "$ref": "#/$defs/sha256" },
    "identity_probe_sha256": { "$ref": "#/$defs/sha256" },
    "gpuz_sha256": {
      "const": "6cb0ef29682452de81a9576808881685161411a1fad00938ba04131159979c29"
    },
    "debugger_sha256": { "$ref": "#/$defs/sha256" },
    "nvapi_module_sha256": {
      "const": "fbc9aed43bfa5bda19b7f83a809a081a0ce454b6d6003dcabc565ecb3e6afdaf"
    },
    "loaded_nvapi_module": { "$ref": "#/$defs/loaded_nvapi_module" },
    "interface_id": { "const": "0x65fe3aad" },
    "function_rva": { "const": "0x001ad310" },
    "caller_module_name": { "const": "GPU-Z.exe" },
    "caller_rva": { "const": "0x002225b5" },
    "structure_version": { "const": "0x000200a8" },
    "fixed_point_fractional_bits": { "const": 8 },
    "alignment_method": { "const": "bounded_session_order_linear_resampling" },
    "tolerance_celsius": { "const": 0.051 },
    "minimum_direct_advantage_celsius": { "const": 1.0 },
    "selection": { "$ref": "#/$defs/selection" },
    "direct_comparison": {
      "$ref": "#/$defs/direct_comparison"
    },
    "inverted_comparison": {
      "$ref": "#/$defs/inverted_comparison"
    },
    "mapping_status": {
      "enum": ["matched_external_reference", "ambiguous_or_outside_tolerance"]
    },
    "warnings": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "local_timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}$"
    },
    "gpu": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "uuid",
        "driver_version",
        "nvml_version",
        "pci_bus_id",
        "pci_vendor_id",
        "pci_device_id",
        "pci_subsystem_vendor_id",
        "pci_subsystem_device_id",
        "vbios_version"
      ],
      "properties": {
        "name": { "const": "NVIDIA GeForce RTX 3060" },
        "uuid": { "const": "GPU-fca3647e-8390-15a8-f23b-d0f870c9accd" },
        "driver_version": { "const": "610.88" },
        "nvml_version": { "const": "13.610.88" },
        "pci_bus_id": { "const": "00000000:01:00.0" },
        "pci_vendor_id": { "const": "0x10de" },
        "pci_device_id": { "const": "0x2504" },
        "pci_subsystem_vendor_id": { "const": "0x10de" },
        "pci_subsystem_device_id": { "const": "0x1536" },
        "vbios_version": { "const": "94.06.25.00.fc" }
      }
    },
    "loaded_nvapi_module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module_name",
        "proof_command",
        "file_sha256",
        "mapped_start",
        "mapped_end_exclusive",
        "mapped_size_bytes"
      ],
      "properties": {
        "module_name": { "const": "nvapi_impl.dll" },
        "proof_command": { "const": "lmv m nvapi_impl" },
        "file_sha256": {
          "const": "fbc9aed43bfa5bda19b7f83a809a081a0ce454b6d6003dcabc565ecb3e6afdaf"
        },
        "mapped_start": { "type": "string", "pattern": "^0x[0-9a-f]{8}$" },
        "mapped_end_exclusive": { "type": "string", "pattern": "^0x[0-9a-f]{8}$" },
        "mapped_size_bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_file_name",
        "artifact_prefix_sha256",
        "artifact_prefix_size_bytes",
        "selection_method",
        "eligible_session_count",
        "ignored_session_indices_without_exact_channels",
        "rejected_session_indices_with_invalid_exact_channel_data",
        "selected_session_index",
        "recorded_before_timestamp_local",
        "recorded_midpoint_timestamp_local",
        "recorded_after_timestamp_local",
        "session_first_timestamp_local",
        "session_last_timestamp_local",
        "window_first_timestamp_local",
        "window_midpoint_timestamp_local",
        "window_last_timestamp_local",
        "session_started_at_or_before_recorded_before",
        "session_ended_at_or_after_recorded_after",
        "window_contains_recorded_midpoint",
        "boundary_distance_ms",
        "midpoint_distance_ms",
        "reference_sample_count",
        "comparison_sample_count"
      ],
      "properties": {
        "artifact_file_name": { "type": "string", "minLength": 1, "maxLength": 260 },
        "artifact_prefix_sha256": { "$ref": "#/$defs/sha256" },
        "artifact_prefix_size_bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
        "selection_method": { "const": "recorded_bounds_then_midpoint_distance" },
        "eligible_session_count": { "type": "integer", "minimum": 1 },
        "ignored_session_indices_without_exact_channels": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0 }
        },
        "rejected_session_indices_with_invalid_exact_channel_data": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0 }
        },
        "selected_session_index": { "type": "integer", "minimum": 0 },
        "recorded_before_timestamp_local": { "$ref": "#/$defs/local_timestamp" },
        "recorded_midpoint_timestamp_local": { "$ref": "#/$defs/local_timestamp" },
        "recorded_after_timestamp_local": { "$ref": "#/$defs/local_timestamp" },
        "session_first_timestamp_local": { "$ref": "#/$defs/local_timestamp" },
        "session_last_timestamp_local": { "$ref": "#/$defs/local_timestamp" },
        "window_first_timestamp_local": { "$ref": "#/$defs/local_timestamp" },
        "window_midpoint_timestamp_local": { "$ref": "#/$defs/local_timestamp" },
        "window_last_timestamp_local": { "$ref": "#/$defs/local_timestamp" },
        "session_started_at_or_before_recorded_before": { "const": true },
        "session_ended_at_or_after_recorded_after": { "const": true },
        "window_contains_recorded_midpoint": { "const": true },
        "boundary_distance_ms": { "type": "number", "minimum": 0 },
        "midpoint_distance_ms": { "type": "number", "minimum": 0 },
        "reference_sample_count": { "type": "integer", "minimum": 3 },
        "comparison_sample_count": { "type": "integer", "minimum": 3 }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_channel_index",
        "observed_word_index",
        "reference_channel",
        "reference_unit",
        "sample_count",
        "mean_absolute_error_celsius",
        "maximum_absolute_error_celsius",
        "status"
      ],
      "properties": {
        "observed_channel_index": { "type": "integer", "minimum": 0, "maximum": 1 },
        "observed_word_index": { "enum": [10, 11] },
        "reference_channel": { "enum": ["GPU Temperature", "Hot Spot"] },
        "reference_unit": { "const": "°C" },
        "sample_count": { "type": "integer", "minimum": 3 },
        "mean_absolute_error_celsius": { "type": "number", "minimum": 0 },
        "maximum_absolute_error_celsius": { "type": "number", "minimum": 0 },
        "status": { "enum": ["matched_rounding_tolerance", "outside_tolerance"] }
      }
    },
    "comparison_base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparison_kind",
        "combined_mean_absolute_error_celsius",
        "combined_maximum_absolute_error_celsius",
        "mappings"
      ],
      "properties": {
        "comparison_kind": { "enum": ["direct", "inverted"] },
        "combined_mean_absolute_error_celsius": { "type": "number", "minimum": 0 },
        "combined_maximum_absolute_error_celsius": { "type": "number", "minimum": 0 },
        "mappings": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/mapping" }
        }
      }
    },
    "direct_comparison": {
      "allOf": [
        { "$ref": "#/$defs/comparison_base" },
        {
          "properties": {
            "comparison_kind": { "const": "direct" },
            "mappings": {
              "prefixItems": [
                {
                  "allOf": [
                    { "$ref": "#/$defs/mapping" },
                    {
                      "properties": {
                        "observed_channel_index": { "const": 0 },
                        "observed_word_index": { "const": 10 },
                        "reference_channel": { "const": "GPU Temperature" }
                      }
                    }
                  ]
                },
                {
                  "allOf": [
                    { "$ref": "#/$defs/mapping" },
                    {
                      "properties": {
                        "observed_channel_index": { "const": 1 },
                        "observed_word_index": { "const": 11 },
                        "reference_channel": { "const": "Hot Spot" }
                      }
                    }
                  ]
                }
              ],
              "items": false
            }
          }
        }
      ]
    },
    "inverted_comparison": {
      "allOf": [
        { "$ref": "#/$defs/comparison_base" },
        {
          "properties": {
            "comparison_kind": { "const": "inverted" },
            "mappings": {
              "prefixItems": [
                {
                  "allOf": [
                    { "$ref": "#/$defs/mapping" },
                    {
                      "properties": {
                        "observed_channel_index": { "const": 0 },
                        "observed_word_index": { "const": 10 },
                        "reference_channel": { "const": "Hot Spot" }
                      }
                    }
                  ]
                },
                {
                  "allOf": [
                    { "$ref": "#/$defs/mapping" },
                    {
                      "properties": {
                        "observed_channel_index": { "const": 1 },
                        "observed_word_index": { "const": 11 },
                        "reference_channel": { "const": "GPU Temperature" }
                      }
                    }
                  ]
                }
              ],
              "items": false
            }
          }
        }
      ]
    }
  }
}
